{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": [
      "tree-sitter-cli/dsl"
    ]
  },
  "tasks": {
    "bundle": "deno -A ./main/bundle.ts",
    "test": "deno test main/",
    "test-grammar": {
      "command": "npx tree-sitter test",
      "dependencies": [
        "bundle",
        "generate"
      ]
    },
    "parse": {
      "command": "tree-sitter parse example.blade.php",
      "dependencies": [
        "bundle",
        "generate"
      ]
    },
    "generate-ast": {
      "command": "cargo build -p ast",
      "dependencies": [
        "generate"
      ]
    },
    "generate": {
      "command": "deno task build",
      "dependencies": [
        "bundle"
      ]
    },
    "wasm": {
      "command": "deno task prestart",
      "dependencies": [
        "generate"
      ]
    }
  },
  "allowScripts": ["npm:esbuild@0.20.2", "npm:tree-sitter-cli@0.25.6"]
}
